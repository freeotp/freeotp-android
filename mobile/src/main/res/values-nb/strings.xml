    <string name="main_about_title">FreeOTP versjon %1$s (%2$d)</string>
    <string name="main_about_message">Copyright Red Hat&lt;br/&gt;&lt;br/&gt;FreeOTP er lisensiert under &lt;a href=&quot;https://www.apache.org/licenses/LICENSE-2.0.html&quot;&gt;Apache 2.0&lt;/a&gt;.&lt;br/&gt;&lt;br/&gt;For mer informasjon, se &lt;a href=&quot;https://freeotp.github.io&quot;&gt;nettstedet vårt&lt;/a&gt;.</string>
    <string name="main_welcome">Velkommen til FreeOTP!\n\nLegg til en nøkkel for å komme i gang.</string>
    <string name="main_deletion_title">Slett valgte nøkler?</string>
    <string name="main_deletion_message">Å slette en nøkkel deaktiverer den ikke hos tjenesten. Hvis du fortsetter, kan du bli låst ute av kontoen din. Sletting av en nøkkel kan ikke angres.</string>
    <string name="main_unsafe_title">Nøkkelen er usikker!</string>
    <string name="main_unsafe_message">Nøkkelen du prøver å legge til, inneholder svake kryptografiske parametere. Bruk av denne nøkkelen frarådes på det sterkeste! Kontakt nøkkelleverandøren din.</string>
    <string name="main_invalid_title">Nøkkelen er ugyldig!</string>
    <string name="main_invalid_message">Nøkkelen du prøver å legge til, er ugyldig. Kontakt nøkkelleverandøren din.</string>
    <string name="main_error_title">Feil!</string>
    <string name="main_error_message">Det oppsto en feil under forsøket på å legge til en nøkkel.</string>
    <string name="main_lock_message">Denne nøkkelen krever at du autentiserer deg hver gang du bruker den. Det betyr at skjermlåsen på enheten din må være aktivert. Aktiver skjermlås og legg til nøkkelen på nytt.</string>
    <string name="main_lock_title">Skjermlås kreves!</string>
    <string name="main_invalidated_title">Nøkkelen er ugyldiggjort!</string>
    <string name="main_invalidated_message">Nøkkelen er ugyldiggjort av Android KeyStore. Dette kan skyldes en endring i skjermlåsinnstillingene dine. Nøkkelen er fjernet. Kontakt nøkkelleverandøren din.</string>
